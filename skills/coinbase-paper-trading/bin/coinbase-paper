#!/usr/bin/env python3
"""coinbase-paper: launcher for the paper-only Coinbase simulator.

PAPER only: virtual cash and simulated fills; never places a real order.
Resolves the sibling ``scripts`` directory from this file's real path, so it
works from any working directory, through symlinks, and from paths with spaces.
"""

import json
import os
import sys

MINIMUM_PYTHON = (3, 11)


def _fail(code, message):
    error = {"code": code, "message": message}
    sys.stdout.write(json.dumps({"mode": "PAPER", "ok": False, "error": error}))
    sys.stdout.write("\n")
    return 1


def _launch():
    if sys.version_info < MINIMUM_PYTHON:
        return _fail("UNSUPPORTED_RUNTIME", "Python 3.11 or newer is required")
    here = os.path.dirname(os.path.realpath(__file__))
    scripts = os.path.join(os.path.dirname(here), "scripts")
    if not os.path.isfile(os.path.join(scripts, "paper_cli.py")):
        return _fail(
            "RUNTIME_INCOMPLETE",
            "scripts/paper_cli.py is missing beside bin/; reinstall the complete bundle",
        )
    # Installed code stays free of bytecode caches; the sibling runtime wins
    # over any same-named module on PYTHONPATH or in the working directory.
    sys.dont_write_bytecode = True
    sys.path[:] = [scripts] + [entry for entry in sys.path if entry not in ("", here)]
    from paper_cli import main

    return main()


if __name__ == "__main__":
    sys.exit(_launch())
